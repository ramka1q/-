{
	"schemaVersion": 1,
	"id": "mymod",
	"version": "${version}",
	"name": "My Mod",
	"description": "Мій перший мод",
	"authors": [
		"ramka1q"
	],
	"contact": {
		"homepage": "https://github.com/ramka1q/-",
		"sources": "https://github.com/ramka1q/-"
	},
	"license": "CC0-1.0",
	"icon": "assets/mymod/icon.png",
